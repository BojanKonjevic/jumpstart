[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "(( name ))"
version = "0.1.0"
description = ""
requires-python = ">=3.12"
dependencies = [
[% for dep in deps %]
  "(( dep ))",
[% endfor %]
]

[dependency-groups]
dev = [
[% for dep in dev_deps %]
  "(( dep ))",
[% endfor %]
]

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
pythonpath = ["src"]

[tool.ruff]
line-length = 88
exclude = ["alembic/", ".venv/"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "ANN", "SIM"]

[tool.mypy]
strict = true
[% for section, overrides in tool_overrides.items() %]
[% for override in overrides %]
[[tool.(( section )).overrides]]
[% for key, val in override.items() %]
(( key )) = (( val | tojson ))
[% endfor %]
[% endfor %]
[% endfor %]
